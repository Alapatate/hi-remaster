{
  "expo": {
    "name": "HI",
    "slug": "hi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "scheme": "hi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/LOGO HI/4x/HI@4x.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f6f5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.phi.hi",
      "supportsTablet": true
    },
    "android": {
      "package": "com.phi.hi",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#f8f6f5"
      },
      "permissions": [],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/AppIcons/appstore.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "react-native-video",
      "react-native-bottom-tabs",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6d4bb2b-c81e-4735-a806-ad163298cb6a"
      }
    },
    "owner": "alapatate"
  }
}
